# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.sqlite*

# Node / Vite
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
*.tsbuildinfo

# Env / secrets
.env
.env.local
*.pem

# AI artifacts — ignored by default (trained artifacts are large and
# vary per environment), but we carve out the EnviroGuard baseline so the
# backend service has a real trained model loaded on first boot.
# See ai/enviroguard/README.md for the training protocol + metrics.
ai/**/artifacts/
!ai/enviroguard/artifacts/
!ai/enviroguard/artifacts/*.onnx
!ai/enviroguard/artifacts/*.json
*.tflite
*.h5

# IDE / OS
.idea/
.vscode/
.DS_Store

# Reports scratch dir
/tmp/geosentinel-reports/
