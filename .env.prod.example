# GeoSentinel production secrets — copy to `.env` before running
# `docker compose -f docker-compose.prod.yml up -d`.

# Postgres
POSTGRES_DB=geosentinel
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=replace-me

# InfluxDB
INFLUXDB_USERNAME=geosentinel
INFLUXDB_PASSWORD=replace-me
INFLUXDB_ORG=geosentinel
INFLUXDB_BUCKET=sensor_data
INFLUXDB_TOKEN=replace-me-long-random-token

# Backend
JWT_SECRET_KEY=replace-me-very-long-random
MQTT_GATEWAY_API_KEY=replace-me-per-gateway
ALLOWED_ORIGINS=https://geosentinel.example.com
GUNICORN_WORKERS=4

# Notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@geosentinel.app

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sentinel-1 InSAR (optional)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
