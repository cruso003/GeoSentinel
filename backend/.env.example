# --- Database ---
DATABASE_URL=postgresql+asyncpg://geosentinel:geosentinel@localhost:5432/geosentinel
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=devtoken
INFLUXDB_ORG=geosentinel
INFLUXDB_BUCKET=sensor_data

# --- Auth ---
JWT_SECRET_KEY=replace-me-with-32-character-secret-key-at-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_GATEWAY_API_KEY=replace-with-gateway-key

# --- ESA Copernicus (InSAR) ---
ESA_DHUS_USERNAME=
ESA_DHUS_PASSWORD=

# --- Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@geosentinel.app
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- App ---
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_MOCK_STREAM=true
